grammar DynamicBTFlowNode extends ConcreteBT {

 //overriding the parent class to not allow single nodes in it

@Override
   BehaviorTree = "BehaviorTree" Name "{" "root" root:DynamicFlowNode "}";
    // Dynamic BTflow node definition - separate node type with different keyword
    DynamicFlowNode extends FlowNode = 
      "FlowNode" "{" 
          (Decorator | Service)*     
          succri:SuccessCriteria
          childType:ChildType
          nodeGraph:NodeGraph 
      "}";

    //enums
    enum SuccessCriteria = "ALL" | "ANY" | "COUNT" | "PERCENTAGE" | "SIGNAL";
    enum TemporalType = "MEETS" | "BEFORE" | "AFTER" | "OVERLAPS" | "DURING";
    enum ChildType = "ALLACTION" | "ALLFLOW"; 
    

    // NodeGraph definition - separate top-level production
    NodeGraph = "Nodegraph" Name "{"
                    (BTNode)*
                    (Relation)*
                "}";                     
   
     Relation = 
    "relation" source:Name@BTNode "--[" temptype:TemporalType "]-->" target:Name@BTNode ";";
    


}