grammar DynamicBTFlowNode extends CRF {
    
    // Dynamic BTflow node definition - separate production to avoid conflicts
 BTFlowNodeDefinition = "BTFlowNode" Name "{" SuccessDefinition ChildTypeDefinition (Service | Decorator | NodeGraph | BTFlowNodeDefinition)* "}";

    //success criteria definition
    SuccessDefinition = "success:" SuccessType ",";
    SuccessType = all:"ALL" | any:"ANY" | count:"COUNT" | percentage:"PERCENTAGE" | signal:"SIGNAL";
    
    //child type definition
    ChildType = allactions:"ALLACTIONS" | allflow:"ALLFLOW" | allflows:"ALLFLOWS";
    ChildTypeDefinition = "childType:" ChildType ",";  

    // NodeGraph definition - separate top-level production
    NodeGraph = "Nodegraph" Name "{"
                    NodesDefinition
                    RelationsDefinition
                "}";                     

    NodesDefinition = (NodeDefinition)*;
    RelationsDefinition = (RelationDefinition)*;

    NodeDefinition = ActionInstance | BTFlowNodeDefinition;
   
    
        RelationDefinition = SourceNode "--[" TemporalType "]-->" TargetNode;
    
    SourceNode = Name;
    TargetNode = Name;
    
    TemporalType = "MEETS" | "BEFORE" | "AFTER" | "OVERLAPS" | "DURING";
    


}