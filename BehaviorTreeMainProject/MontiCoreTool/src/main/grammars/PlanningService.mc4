grammar PlanningService extends ConcreteBT {


  abstract PService extends Service;

  // Added keywords "domain" and "problem" to make the model readable
  PDDLPlannerService extends PService = "Planning Service" planner:Name@Planner ;
  
  // 2. Planner hierarchy
  abstract symbol Planner = name:Name;

  PDDLPlanner extends Planner = "PDDLPlanner" name:Name ("domain" domain:Name@Domain)?   ("problem" problem:Name)?;

 symbol Domain = "domain" "Level" actLev:ActionLevel;


}
