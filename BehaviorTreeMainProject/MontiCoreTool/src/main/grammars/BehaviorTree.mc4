 grammar BehaviorTree extends  de.monticore.types.MCBasicTypes {

  symbol BehaviorTree = "BehaviorTree" Name "{" "root" root:FlowNode "}";

  // abstract node class
  abstract symbol BTNode = name:Name (Decorator | Service)*; 

  // flow nodes
  abstract  FlowNode extends BTNode =   (Service | Decorator | children:BTNode)* ;
  //concrete flownodes
  Sequence extends FlowNode = "Sequence" "{" (Service | Decorator | children:BTNode)* "}";
  Fallback extends FlowNode = "Fallback" "{" (Service | Decorator | children:BTNode)* "}";
 

  // action nodes
  abstract  ActionNode extends BTNode = "Action" ("{" (Decorator | Service)* "}")? ;
  PickUp extends ActionNode = "Action" name:Name@BTNode ("{" (Decorator | Service)* "}")?;
 
 
 // services and decorators
  abstract Service = "Service" name:Name;
  abstract Decorator = "Decorator" name:Name;
  //concrete examples of services
  GripperEmpty extends Decorator = "Decorator" name:Name;
  CalcDist extends Service = "Service" name:Name;

// tokens definition

  token PDDL_START = LOWER_CASE_LETTER;
  token PDDL_CHAR = LETTER | NUMBER | '-' | '_';
   token LOWER_CASE_LETTER = 'a'..'z';  
   token LETTER = 'a'..'z' | 'A'..'Z';
   token NUMBER = '0'..'9';
   token FILEPATH = LETTER | NUMBER | '_'  | '.' | '/' | '\\' | '-' ;

    token STRING_VALUE = '"' (STRING_CHAR)* '"';
  token DOUBLE_VALUE = NUMBER+ '.' NUMBER+;
    token STRING_CHAR = LETTER | NUMBER | '_'  | '.' | '/' | '\\' | '-' ;
}





