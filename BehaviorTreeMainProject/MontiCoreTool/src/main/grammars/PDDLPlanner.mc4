grammar PDDLPlanner extends BehaviorTree {
  PlannerDefinition = "PDDLPlanner" Name "{" 
                FilesSection
                SettingsSection "}";
  // Files section
  FilesSection = "files" "{" (FileAssignment ";")* "}";  
  FileAssignment = DomainAssignment | ProblemAssignment | PlannerAssignment;
  DomainAssignment = "domain" "=" FilePath;
  ProblemAssignment = "problem" "=" FilePath;
  PlannerAssignment = "planner" "=" FilePath;
  FilePath = STRING_VALUE; 
  // Settings section
  SettingsSection = "settings" "{" (SettingAssignment ";")* "}"; 
  SettingAssignment = ConfigurationAssignment | PlannerNameAssignment;
  ConfigurationAssignment = "configuration" "=" Name;
  PlannerNameAssignment = "plannerName" "=" Name;
}