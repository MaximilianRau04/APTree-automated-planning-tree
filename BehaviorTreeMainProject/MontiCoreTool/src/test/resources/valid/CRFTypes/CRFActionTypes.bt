// 5. Action Type Definition (General Template)
Action PickUpHL {
    acttype: HIGHLEVEL
    parameters {
        obj: Element
        grabPos: Location
        client: Robot
    }
    preconditions {
        atplace(obj, grabPos)
        holding(client, obj)   
    }    
    effects {
        holding(client, obj)
    }   
}

Action PlaceHL {
    acttype: HIGHLEVEL
    parameters {
        obj: Element
        targetPos: Location
        client: Robot
    }
    preconditions {
        holding(client, obj)
    }    
    effects {
        atplace(obj, targetPos)
        holding(client, obj)
    }   
}