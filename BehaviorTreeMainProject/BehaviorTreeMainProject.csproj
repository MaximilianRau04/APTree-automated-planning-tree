<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MountainGoap" Version="0.4.1" />
    <PackageReference Include="Neo4j.Driver" Version="5.15.0" />
  </ItemGroup>

  <!-- Exclude python_service folder from build -->
  <ItemGroup>
    <Compile Remove="python_service/**" />
    <EmbeddedResource Remove="python_service/**" />
    <Content Remove="python_service/**" />
  </ItemGroup>

</Project>
